<?xml version="1.0" encoding="utf-8"?>
<MarkupColumns>
  <!--
    SpecStream Custom Columns — Baker Hughes / ITO Review Workflow
    Generated for SpecStream PoC reference implementation.
    Fields derived from Dashboard SOW and SpecTrack mockup.

    Column Types:
      Text        = free-text entry
      List        = dropdown (values defined in <Items>)
      Number      = numeric input
      CheckMark   = yes/no checkbox
      Date        = date picker
  -->

  <!-- ─── RISK & REVIEW ─────────────────────────────────────── -->
  <Column>
    <Name>Risk Assessment</Name>
    <Type>Text</Type>
    <Width>200</Width>
    <DefaultValue></DefaultValue>
  </Column>

  <Column>
    <Name>Category of Risk</Name>
    <Type>List</Type>
    <Width>130</Width>
    <DefaultValue>NA</DefaultValue>
    <Items>
      <Item>High</Item>
      <Item>Medium</Item>
      <Item>Low</Item>
      <Item>NA</Item>
    </Items>
  </Column>

  <Column>
    <Name>Risk Status</Name>
    <Type>List</Type>
    <Width>120</Width>
    <DefaultValue>Open</DefaultValue>
    <Items>
      <Item>Open</Item>
      <Item>Mitigated</Item>
      <Item>Closed</Item>
    </Items>
  </Column>

  <Column>
    <Name>Action Taken</Name>
    <Type>Text</Type>
    <Width>220</Width>
    <DefaultValue></DefaultValue>
  </Column>

  <!-- ─── ITO SUBMISSION ────────────────────────────────────── -->
  <Column>
    <Name>ITO Submission Stamp</Name>
    <Type>List</Type>
    <Width>150</Width>
    <DefaultValue>No</DefaultValue>
    <Items>
      <Item>Yes</Item>
      <Item>No</Item>
    </Items>
  </Column>

  <!-- ─── BUSINESS POSITION ────────────────────────────────── -->
  <Column>
    <Name>Business Position</Name>
    <Type>List</Type>
    <Width>140</Width>
    <DefaultValue>No</DefaultValue>
    <Items>
      <Item>Yes</Item>
      <Item>No</Item>
    </Items>
  </Column>

  <Column>
    <Name>Send to OTR</Name>
    <Type>List</Type>
    <Width>110</Width>
    <DefaultValue>No</DefaultValue>
    <Items>
      <Item>Yes</Item>
      <Item>No</Item>
    </Items>
  </Column>

  <!-- ─── TASK / WORKFLOW METADATA ─────────────────────────── -->
  <Column>
    <Name>Department</Name>
    <Type>List</Type>
    <Width>130</Width>
    <DefaultValue></DefaultValue>
    <Items>
      <Item>Materials</Item>
      <Item>ITO</Item>
      <Item>Engineering</Item>
      <Item>Procurement</Item>
      <Item>Contracts</Item>
      <Item>HSE</Item>
      <Item>Quality</Item>
      <Item>Other</Item>
    </Items>
  </Column>

  <Column>
    <Name>Customer</Name>
    <Type>Text</Type>
    <Width>140</Width>
    <DefaultValue></DefaultValue>
  </Column>

  <Column>
    <Name>Prioritization</Name>
    <Type>List</Type>
    <Width>110</Width>
    <DefaultValue>Medium</DefaultValue>
    <Items>
      <Item>High</Item>
      <Item>Medium</Item>
      <Item>Low</Item>
    </Items>
  </Column>

  <Column>
    <Name>Comment Type</Name>
    <Type>List</Type>
    <Width>130</Width>
    <DefaultValue>Internal</DefaultValue>
    <Items>
      <Item>Internal</Item>
      <Item>External</Item>
      <Item>NA</Item>
    </Items>
  </Column>

  <Column>
    <Name>Spec Title</Name>
    <Type>Text</Type>
    <Width>200</Width>
    <DefaultValue></DefaultValue>
  </Column>

  <Column>
    <Name>Due Date</Name>
    <Type>Date</Type>
    <Width>110</Width>
    <DefaultValue></DefaultValue>
  </Column>

</MarkupColumns>
